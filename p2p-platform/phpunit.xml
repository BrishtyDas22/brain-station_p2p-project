<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            The test suite runs against the ISOLATED MySQL 8.0 instance that
            this project owns on port 3307 (own datadir, own config, own test
            database). The shared workstation MySQL80 service on port 3306 is
            never touched by the test run.

            That instance has log_bin_trust_function_creators=1, so the
            mandatory financial-integrity triggers are really installed and
            the ledger migrations fail CLOSED. The trigger-bypass escape hatch
            (LEDGER_ALLOW_UNENFORCED_TRIGGERS_IN_TEST_SCHEMA) is deliberately
            NOT set here.
        -->
        <env name="DB_CONNECTION" value="mysql_p2ptest"/>
        <!--
            `P2P_DB_CONNECTION` is what config/database.php actually reads for
            the default connection, so it is pinned here as well. Both are set
            so the test suite cannot be redirected by an ambient `.env` or by a
            stray environment variable — the tests must land on the isolated
            3307 instance every single time.
        -->
        <env name="P2P_DB_CONNECTION" value="mysql_p2ptest"/>
        <env name="DB_URL" value=""/>
        <env name="P2PTEST_DB_HOST" value="127.0.0.1"/>
        <env name="P2PTEST_DB_PORT" value="3307"/>
        <env name="P2PTEST_DB_DATABASE" value="p2p_platform_test"/>
        <env name="P2PTEST_DB_USERNAME" value="p2p_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
