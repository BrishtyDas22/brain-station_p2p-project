APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=p2p_platform_dev
DB_USERNAME=p2p_app
DB_PASSWORD=

# The P2P platform uses two ISOLATED MySQL instances, each on its own port and
# with its own least-privilege user. The connection routing lives in
# `config/database.php`, NOT in the legacy `DB_*` block above.
#
#   mysql_p2pdev  -> the DEVELOPMENT database   (default)
#   mysql_p2ptest -> the AUTOMATED-TEST database (pinned by phpunit.xml)
#
# Port 3306 is the shared system MySQL and is NEVER used by this project.
P2P_DB_CONNECTION=mysql_p2pdev

P2PDEV_DB_HOST=127.0.0.1
P2PDEV_DB_PORT=3308
P2PDEV_DB_DATABASE=p2p_platform_dev
P2PDEV_DB_USERNAME=p2p_dev
# The dev password is read from a file only the current OS user can read.
# P2PDEV_DB_PASSWORD_FILE=C:\ProgramData\MySQL\MySQL80-P2PDev\secrets\p2p_dev_password.txt
# P2PDEV_DB_PASSWORD=

P2PTEST_DB_HOST=127.0.0.1
P2PTEST_DB_PORT=3307
P2PTEST_DB_DATABASE=p2p_platform_test
P2PTEST_DB_USERNAME=p2p_test
# The test password is read from a file only the current OS user can read.
# P2PTEST_DB_PASSWORD_FILE=C:\ProgramData\MySQL\MySQL80-P2PTest\secrets\p2p_test_password.txt
# P2PTEST_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
